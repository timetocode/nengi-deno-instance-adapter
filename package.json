{
  "name": "nengi-deno-instance-adapter",
  "version": "2.0.0-rc.128",
  "description": "Native Deno server adapter for nengi instances",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "test": "npm run build && deno run --allow-net --allow-read test/native-smoke.ts",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build"
  },
  "author": "Alex // timetocode",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timetocode/nengi-deno-instance-adapter.git"
  },
  "homepage": "https://github.com/timetocode/nengi-deno-instance-adapter#readme",
  "bugs": {
    "url": "https://github.com/timetocode/nengi-deno-instance-adapter/issues"
  },
  "dependencies": {
    "nengi-dataviews": ">=2.0.0-rc.128 <2.0.0"
  },
  "devDependencies": {
    "nengi": "2.0.0-rc.128",
    "nengi-websocket-client-adapter": "2.0.0-rc.128",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "nengi": ">=2.0.0-rc.128 <2.0.0"
  },
  "engines": {
    "deno": ">=2.0.0"
  }
}
